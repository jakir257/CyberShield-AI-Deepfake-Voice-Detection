{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShield AI | Advanced Detection Dashboard</title>
    <!-- External CSS Dependencies -->
    <link rel="stylesheet" href="{% static 'cyber/style.css'%}">
    <script src="{% static 'cyber/script.js'%}"></script>
</head>
<body class="text-slate-200 antialiased min-h-screen">

    <!-- Authentication Container (Sign In / Sign Up) -->
    <div id="auth-container" class="min-h-screen flex items-center justify-center p-4">
        <div class="glass-card p-8 rounded-2xl w-full max-w-md border border-slate-700 shadow-2xl relative overflow-hidden">
            <!-- Decorative Accent Gradient -->
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-red-600/20 rounded-full blur-2xl"></div>
            
            <!-- Logo Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-extrabold tracking-tighter text-red-500">CYBERSHIELD <span class="text-slate-100">AI</span></h1>
                <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Cybercrime Detection Platform</p>
            </div>

            <!-- Sign In Form -->
            <div id="auth-signin">
                <h2 class="text-xl font-bold mb-1 text-slate-100">Sign In</h2>
                <p class="text-slate-400 text-sm mb-6">Enter your credentials to access the terminal.</p>
                <form id="signin-form" class="space-y-4">
                    <div>
                        <label class="block text-xs uppercase font-bold text-slate-400 mb-1">Email or Phone Number</label>
                        <div class="relative">
                            <i data-lucide="user" class="w-5 h-5 absolute left-3 top-3 text-slate-500"></i>
                            <input type="text" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-red-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase font-bold text-slate-400 mb-1">Password</label>
                        <div class="relative">
                            <i data-lucide="lock" class="w-5 h-5 absolute left-3 top-3 text-slate-500"></i>
                            <input type="password" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-red-500">
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 transition font-bold py-3 rounded-xl text-white mt-2">Access Dashboard</button>
                </form>
                <p class="text-center text-sm text-slate-400 mt-6">
                    Don't have an account? 
                    <button id="goto-signup-btn" class="text-red-400 hover:underline font-semibold ml-1">Sign Up</button>
                </p>
            </div>

            <!-- Sign Up Form -->
            <div id="auth-signup" class="hidden">
                <h2 class="text-xl font-bold mb-1 text-slate-100">Create Account</h2>
                <p class="text-slate-400 text-sm mb-6">Register a new analyst account.</p>
                <form id="signup-form" class="space-y-4">
                    <div>
                        <label class="block text-xs uppercase font-bold text-slate-400 mb-1">Full Name</label>
                        <div class="relative">
                            <i data-lucide="id-card" class="w-5 h-5 absolute left-3 top-3 text-slate-500"></i>
                            <input type="text" id="signup-fullname" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-red-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase font-bold text-slate-400 mb-1">Email or Phone Number</label>
                        <div class="relative">
                            <i data-lucide="mail" class="w-5 h-5 absolute left-3 top-3 text-slate-500"></i>
                            <input type="text" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-red-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase font-bold text-slate-400 mb-1">Password</label>
                        <div class="relative">
                            <i data-lucide="lock" class="w-5 h-5 absolute left-3 top-3 text-slate-500"></i>
                            <input type="password" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-red-500">
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 transition font-bold py-3 rounded-xl text-white mt-2">Register Account</button>
                </form>
                <p class="text-center text-sm text-slate-400 mt-6">
                    Already have an account? 
                    <button id="goto-signin-btn" class="text-red-400 hover:underline font-semibold ml-1">Sign In</button>
                </p>
            </div>
        </div>
    </div>

    <!-- Main Application Wrapper (Hidden until authenticated) -->
    <div id="dashboard-app" class="hidden">
        <!-- Sidebar Navigation -->
        <aside class="fixed left-0 top-0 h-screen w-64 glass-card z-50 flex flex-col">
            <div class="p-6">
                <h1 class="text-2xl font-extrabold tracking-tighter text-red-500">CYBERSHIELD <span class="text-slate-100">AI</span></h1>
                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mt-1">Cybercrime Detection Platform</p>
            </div>

            <nav class="flex-1 px-4 space-y-2 mt-4">
                <div data-tab="dashboard" id="nav-dashboard" class="nav-link active-tab flex items-center p-3 rounded-lg">
                    <i data-lucide="layout-dashboard" class="mr-3 w-5"></i> Dashboard
                </div>
                <div data-tab="voice" id="nav-voice" class="nav-link flex items-center p-3 rounded-lg text-slate-400">
                    <i data-lucide="mic" class="mr-3 w-5"></i> Voice Detection
                </div>
                <div data-tab="message" id="nav-message" class="nav-link flex items-center p-3 rounded-lg text-slate-400">
                    <i data-lucide="mail" class="mr-3 w-5"></i> Scam Message
                </div>
                <div data-tab="url" id="nav-url" class="nav-link flex items-center p-3 rounded-lg text-slate-400">
                    <i data-lucide="link" class="mr-3 w-5"></i> URL Analysis
                </div>
                <div data-tab="forensic" id="nav-forensic" class="nav-link flex items-center p-3 rounded-lg text-slate-400">
                    <i data-lucide="file-search" class="mr-3 w-5"></i> Forensic Reports
                </div>
            </nav>

            <div class="p-6 border-t border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div id="user-avatar" class="w-8 h-8 rounded-full bg-red-600 flex items-center justify-center font-bold text-xs">JD</div>
                    <div>
                        <p id="user-display-name" class="text-sm font-bold truncate w-24">John Doe</p>
                        <p class="text-[10px] text-slate-500">Security Analyst</p>
                    </div>
                </div>
                <button id="logout-btn" class="logout-btn" type="button" title="Logout">
                    <span class="logout-icon">⇥</span>
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="ml-64 p-8 min-h-screen">
            
            <!-- Tab 1: Dashboard Overview -->
            <section id="tab-dashboard" class="tab-content">
                <header class="flex justify-between items-center mb-8">
                    <div>
                        <h2 class="text-3xl font-bold">Security Overview</h2>
                        <p class="text-slate-400">Real-time threat monitoring dashboard</p>
                    </div>
                    <button class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-semibold flex items-center">
                        <i data-lucide="shield-alert" class="mr-2 w-4"></i> System Secure
                    </button>
                </header>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <div class="glass-card p-6 rounded-2xl">
                        <p class="text-slate-500 text-sm">Total Scans</p>
                        <h3 class="text-3xl font-bold mt-1">1,284</h3>
                    </div>
                    <div class="glass-card p-6 rounded-2xl">
                        <p class="text-slate-500 text-sm">AI Voices Detected</p>
                        <h3 class="stat-number stat-red">42</h3>
                    </div>
                    <div class="glass-card p-6 rounded-2xl">
                        <p class="text-slate-500 text-sm">Phishing URLs Blocked</p>
                        <h3 class="text-3xl font-bold mt-1">156</h3>
                    </div>
                    <div class="glass-card p-6 rounded-2xl">
                        <p class="text-slate-500 text-sm">Avg Accuracy</p>
                        <h3 class="stat-number stat-green">98.2%</h3>
                    </div>
                </div>

                <div class="glass-card rounded-2xl p-8 text-center border-dashed border-2 border-slate-700">
                    <i data-lucide="zap" class="mx-auto w-12 h-12 text-yellow-500 mb-4"></i>
                    <h4 class="text-xl font-bold">Quick Analysis</h4>
                    <p class="text-slate-400 mb-6">Start by selecting a module from the sidebar to detect DeepFakes or Scams.</p>
                    <div class="flex justify-center space-x-4">
                        <button data-tab="voice" class="quick-nav-btn bg-slate-700 px-6 py-2 rounded-full hover:bg-slate-600">Scan Voice</button>
                        <button data-tab="url" class="quick-nav-btn bg-slate-700 px-6 py-2 rounded-full hover:bg-slate-600">Check Link</button>
                    </div>
                </div>              
            </section>

            <!-- Tab 2: Voice Detection -->
            <section id="tab-voice" class="tab-content hidden">
                <div class="voice-page-header">
                    <h2>DeepFake Voice Detection</h2>
                    <p>Module 3: Audio Feature Extraction & Detection</p>
                </div>
                
                <div class="voice-layout">
                    
                    <!-- =========================================================
                        VOICE UPLOAD / STANDARDIZATION CARD
                    ========================================================= -->

                    <div class="voice-upload-card" id="voice-upload-card">

                        <!-- Upload State -->
                        <div id="voice-upload-state">

                            <i
                                data-lucide="upload-cloud"
                                class="voice-upload-icon"
                            ></i>

                            <h3>Upload Audio File</h3>

                            <p class="voice-upload-text">
                                Drag and drop WAV, MP3, M4A or FLAC files here
                                <br>
                                <span>(Max 10MB)</span>
                            </p>

                            <form
                                id="audio-upload-form"
                                method="POST"
                                action="{% url 'upload_audio' %}"
                                enctype="multipart/form-data"
                            >

                                {% csrf_token %}

                                <input
                                    type="file"
                                    id="audio-file-input"
                                    name="audio"
                                    accept=".wav,.mp3,.m4a,.flac"
                                    required
                                    hidden
                                >

                                <button
                                    type="button"
                                    id="select-audio-btn"
                                >
                                    Select File
                                </button>

                            </form>

                            <p
                                id="selected-file-name"
                                class="selected-file-name"
                                style="display: none;"
                            >
                                Selected File:
                                <strong id="selected-file-text"></strong>
                            </p>

                        </div>


                        <!-- =====================================================
                            SUCCESS / STANDARDIZED AUDIO STATE
                        ====================================================== -->

                        <div
                            id="audio-result"
                            class="audio-result"
                            style="display: none;"
                        >

                            <div class="audio-success-icon">
                                ✓
                            </div>

                            <h3>Audio Standardized Successfully</h3>

                            <p class="audio-result-text">
                                Your audio has been converted and prepared
                                for deepfake voice analysis.
                            </p>

                            <!-- File Names -->

                            <div class="audio-file-names">

                                <p>
                                    <span>Original File</span>
                                    <strong id="original-filename"></strong>
                                </p>

                                <p>
                                    <span>Standardized WAV</span>
                                    <strong id="processed-filename"></strong>
                                </p>

                            </div>

                            <!-- Audio Information -->

                            <div class="audio-specs">

                                <div class="audio-spec">
                                    <span>Sample Rate</span>
                                    <strong>
                                        <span id="sample-rate"></span> Hz
                                    </strong>
                                </div>

                                <div class="audio-spec">
                                    <span>Channels</span>
                                    <strong id="channels"></strong>
                                </div>

                                <div class="audio-spec">
                                    <span>Duration</span>
                                    <strong>
                                        <span id="duration"></span> sec
                                    </strong>
                                </div>

                            </div>

                            <!-- Converted Audio -->

                            <div class="converted-audio-section">

                                <h4>Standardized WAV Audio</h4>

                                <audio
                                    id="processed-audio"
                                    controls
                                >
                                    Your browser does not support audio playback.
                                </audio>

                            </div>
                            
                            <!-- =====================================================
                                NOISE REDUCTION
                            ====================================================== -->

                            <div class="processing-info-section">

                                <h4>
                                    Noise Reduction
                                </h4>

                                <p class="processing-description">
                                    Background noise has been reduced using
                                    conservative filtering.
                                </p>

                                <div class="processing-info-row">

                                    <span>
                                        Reduction Strength
                                    </span>

                                    <strong>
                                        <span id="noise-reduction-strength"></span>
                                    </strong>

                                </div>

                                <audio
                                    id="noise-reduced-audio"
                                    controls
                                >
                                    Your browser does not support audio playback.
                                </audio>

                            </div>


                            <!-- =====================================================
                                SILENCE TRIMMING
                            ====================================================== -->

                            <div class="processing-info-section">

                                <h4>
                                    Silence Trimming
                                </h4>

                                <div class="processing-info-row">

                                    <span>
                                        Original Duration
                                    </span>

                                    <strong>
                                        <span id="original-duration"></span>
                                        sec
                                    </strong>

                                </div>


                                <div class="processing-info-row">

                                    <span>
                                        After Trimming
                                    </span>

                                    <strong>
                                        <span id="trimmed-duration"></span>
                                        sec
                                    </strong>

                                </div>

                            </div>

                            <!-- =====================================================
                                TRIMMED AUDIO
                            ====================================================== -->

                            <div class="processing-info-section">

                                <h4>
                                    Audio After Silence Trimming
                                </h4>

                                <p class="processing-description">
                                    Long silence at the beginning and end
                                    has been removed.
                                </p>

                                <audio
                                    id="trimmed-audio"
                                    controls
                                >
                                    Your browser does not support audio playback.
                                </audio>

                            </div>

                            <!-- =====================================================
                                AUDIO SEGMENTATION
                            ====================================================== -->

                            <div class="processing-info-section">

                                <h4>
                                    Audio Segmentation
                                </h4>


                                <div class="processing-info-row">

                                    <span>
                                        Segment Duration
                                    </span>

                                    <strong>
                                        <span id="segment-duration"></span>
                                        sec
                                    </strong>

                                </div>


                                <div class="processing-info-row">

                                    <span>
                                        Segments Created
                                    </span>

                                    <strong>
                                        <span id="segment-count"></span>
                                    </strong>

                                </div>

                            </div>

                            <!-- =====================================================
                                AUDIO SEGMENTS — PLAYBACK
                            ====================================================== -->

                            <div class="processing-info-section">

                                <h4>
                                    Audio Segments
                                </h4>

                                <p class="processing-description">
                                    The trimmed audio has been divided into
                                    standardized 4-second segments.
                                </p>

                                <div id="audio-segments-container">

                                    <!-- JavaScript will add segments here -->

                                </div>

                            </div>

                        </div>


                        <!-- =====================================================
                            ERROR STATE
                        ====================================================== -->

                        <div
                            id="audio-error"
                            class="audio-error"
                            style="display: none;"
                        >

                            <div class="audio-error-icon">
                                !
                            </div>

                            <h3>Audio Processing Failed</h3>

                            <p id="error-message"></p>

                            <button
                                type="button"
                                id="try-again-btn"
                            >
                                Try Again
                            </button>

                        </div>

                    </div>

                    <!-- Analysis Result Area -->
                    <div class="voice-result-card">

                        <h3 class="voice-result-title">

                            <i data-lucide="activity"></i>

                            Analysis Results

                        </h3>


                        <!-- Live feed: uploads arriving from any client (phone included) -->
                        <div id="live-feed-card">

                            <div class="live-feed-head">
                                <span class="live-feed-title">LIVE ACTIVITY</span>
                                <span id="live-dot" class="live-dot"></span>
                            </div>

                            <div id="live-latest" class="live-latest">
                                waiting for uploads...
                            </div>

                            <ul id="live-files" class="live-files"></ul>
                        </div>

                        <div id="voice-result-box">

                            <!-- Probability -->
                            <div class="voice-probability">

                                <span>
                                    DeepFake Probability:
                                </span>

                                <strong>
                                    94.8%
                                </strong>

                            </div>


                            <!-- Progress Bar -->
                            <div class="voice-progress">

                                <div
                                    class="voice-progress-fill"
                                    style="width: 94.8%;">
                                </div>

                            </div>


                            <!-- XAI Explanation -->
                            <div class="voice-xai-box">

                                <p class="voice-xai-title">
                                    Module 5: XAI Explanation
                                </p>

                                <p class="voice-xai-text">
                                    "Artificial artifacts detected in the
                                    12kHz frequency range. Mel-spectrogram
                                    patterns align with synthesized RVC
                                    cloning models."
                                </p>

                            </div>


                            <!-- Status Cards -->
                            <div class="voice-status-grid">

                                <div class="voice-status-card">

                                    <p>
                                        Noise Reduction
                                    </p>

                                    <strong class="status-green">
                                        Applied
                                    </strong>

                                </div>


                                <div class="voice-status-card">

                                    <p>
                                        Trusted Voice
                                    </p>

                                    <strong class="status-red">
                                        No Match
                                    </strong>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tab 3: Scam Message -->
            <section id="tab-message" class="tab-content hidden">
                <h2 class="text-3xl font-bold mb-2">Scam Message Detection</h2>
                <p class="text-slate-400 mb-8">Analyze SMS, Emails, and Messaging texts</p>
                
                <div class="max-w-3xl">
                    <div class="glass-card p-6 rounded-2xl mb-6">
                        <textarea class="w-full h-48 bg-slate-900 border border-slate-700 rounded-xl p-4 text-slate-300 focus:outline-none focus:border-red-500" placeholder="Paste the suspicious message content here..."></textarea>
                        <button class="w-full mt-4 bg-red-600 py-3 rounded-xl font-bold hover:bg-red-700 transition">Analyze Content</button>
                    </div>
                </div>
            </section>

            <!-- Tab 4: URL Analysis -->
            <section id="tab-url" class="tab-content hidden">
                <h2 class="text-3xl font-bold mb-2">Malicious Link Detection</h2>
                <p class="text-slate-400 mb-8">Checking URLs for phishing indicators</p>
                
                <div class="glass-card p-8 rounded-2xl max-w-4xl">
                    <div class="flex space-x-4">
                        <input type="text" class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-6 py-3 focus:outline-none focus:border-cyan-500" placeholder="https://suspicious-site.com/login">
                        <button class="bg-cyan-600 px-8 py-3 rounded-xl font-bold hover:bg-cyan-700 transition">Scan Link</button>
                    </div>
                </div>
            </section>
            
            <!-- Tab 5: Forensic Dashboard -->
            <section id="tab-forensic" class="tab-content hidden">

                <div class="forensic-heading">
                    <h2>Digital Forensic Dashboard</h2>
                    <p>Detailed investigation reports and history</p>
                </div>

                <div class="forensic-table-card">
                
                    <table class="forensic-table">

                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Evidence Type</th>
                                <th>Risk Level</th>
                                <th>Detection Result</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <!-- Report 1 -->
                            <tr>
                                <td class="forensic-time">
                                    2023-10-25 14:22
                                </td>

                                <td>
                                    <div class="evidence-item">
                                        <span class="evidence-icon voice-danger">↗</span>
                                        <span>Voice Clip #92</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="risk-badge critical">
                                        CRITICAL
                                    </span>
                                </td>

                                <td class="detection-result">
                                    DeepFake Detected (94.8%)
                                </td>

                                <td>
                                    <button class="view-report-btn">
                                        View Report
                                    </button>
                                </td>
                            </tr>

                            <!-- Report 2 -->
                            <tr>
                                <td class="forensic-time">
                                    2023-10-25 12:05
                                </td>

                                <td>
                                    <div class="evidence-item">
                                        <span class="evidence-icon url-icon">↗</span>
                                        <span>URL: bit.ly/34x...</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="risk-badge medium">
                                        MEDIUM
                                    </span>
                                </td>

                                <td class="detection-result">
                                    Phishing Suspect
                                </td>

                                <td>
                                    <button class="view-report-btn">
                                        View Report
                                    </button>
                                </td>
                            </tr>

                            <!-- Report 3 -->
                            <tr>
                                <td class="forensic-time">
                                    2023-10-24 18:40
                                </td>

                                <td>
                                    <div class="evidence-item">
                                        <span class="evidence-icon voice-safe">↗</span>
                                        <span>Voice Clip #90</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="risk-badge safe">
                                        SAFE
                                    </span>
                                </td>

                                <td class="detection-result">
                                    Genuine Voice
                                </td>

                                <td>
                                    <button class="view-report-btn">
                                        View Report
                                    </button>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>
    
</body>
</html>
/* =========================================================
   CYBERSHIELD AI
========================================================= */


/* =========================================================
   1. RESET AND GLOBAL SETTINGS
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    color: #e2e8f0;

    background:
        #111827;

    overflow-x: hidden;
}

button,
input,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}

.hidden {
    display: none !important;
}


/* =========================================================
   2. AUTHENTICATION PAGE
========================================================= */

#auth-container {
    min-height: 100vh;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at 50% 35%,
            rgba(239, 68, 68, 0.10),
            transparent 30%
        ),
        #111827;
}


/* Login card */

#auth-container > div {
    position: relative;

    width: 100%;
    max-width: 430px;

    padding: 36px;

    background:
        linear-gradient(
            145deg,
            #243247,
            #192536
        );

    border:
        1px solid
        #3a4a60;

    border-radius: 18px;

    box-shadow:
        0 25px 70px
        rgba(0, 0, 0, 0.45);

    overflow: hidden;
}


/* Red glow */

#auth-container > div::before {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    top: -100px;
    right: -90px;

    border-radius: 50%;

    background:
        rgba(239, 68, 68, 0.16);

    filter:
        blur(40px);

    pointer-events: none;
}


/* Logo */

#auth-container .text-center {
    position: relative;

    text-align: center;

    margin-bottom: 30px;
}

#auth-container h1 {
    color: #ef4444;

    font-size: 28px;

    font-weight: 800;

    letter-spacing: -1px;
}

#auth-container h1 span {
    color: #f1f5f9;
}

#auth-container .text-center p {
    margin-top: 7px;

    color: #8795a9;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 2px;

    text-transform: uppercase;
}


/* Form title */

#auth-container h2 {
    position: relative;

    margin-bottom: 7px;

    color: #f1f5f9;

    font-size: 22px;
}

#auth-container h2 + p {
    margin-bottom: 24px;

    color: #94a3b8;

    font-size: 14px;
}


/* Form */

#auth-container form {
    display: flex;

    flex-direction: column;

    gap: 17px;
}


/* Labels */

#auth-container label {
    display: block;

    margin-bottom: 7px;

    color: #94a3b8;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.6px;

    text-transform: uppercase;
}


/* Input containers */

#auth-container .relative {
    position: relative;
}


/* Inputs */

#auth-container input {
    width: 100%;

    height: 46px;

    padding:
        0 15px
        0 48px;

    color: #e2e8f0;

    background:
        #0d1726;

    border:
        1px solid
        #35455b;

    border-radius: 10px;

    outline: none;

    font-size: 14px;

    transition:
        border 0.2s,
        box-shadow 0.2s;
}

#auth-container input::placeholder {
    color: #64748b;
}

#auth-container input:focus {
    border-color:
        #ef4444;

    box-shadow:
        0 0 0 3px
        rgba(239, 68, 68, 0.10);
}


/* Hide missing Lucide icon elements */

[data-lucide] {
    display: none;
}


/* Login button */

#auth-container button[type="submit"] {
    width: 100%;

    height: 47px;

    color: white;

    background:
        linear-gradient(
            90deg,
            #dc2626,
            #ef4444
        );

    border: none;

    border-radius: 10px;

    font-size: 14px;

    font-weight: 700;

    box-shadow:
        0 10px 25px
        rgba(239, 68, 68, 0.22);

    transition:
        transform 0.2s,
        background 0.2s;
}

#auth-container button[type="submit"]:hover {
    background:
        #dc2626;

    transform:
        translateY(-2px);
}


/* Sign-up text */

#auth-container form + p {
    margin-top: 23px;

    color: #94a3b8;

    font-size: 13px;

    text-align: center;
}

#auth-container form + p button {
    color: #f87171;

    background: transparent;

    border: none;

    font-size: 13px;

    font-weight: 700;
}

#auth-container form + p button:hover {
    text-decoration: underline;
}


/* =========================================================
   3. DASHBOARD LAYOUT
========================================================= */

#dashboard-app {
    min-height: 100vh;

    background:
        #111827;
}


/* Sidebar */

#dashboard-app aside {
    position: fixed;

    top: 0;
    left: 0;

    width: 250px;
    height: 100vh;

    display: flex;

    flex-direction: column;

    background:
        linear-gradient(
            180deg,
            #182437,
            #111a29
        );

    border-right:
        1px solid
        #304057;

    z-index: 100;
}


/* Sidebar logo */

#dashboard-app aside > div:first-child {
    padding:
        27px 25px;

    border-bottom:
        1px solid
        #2c3b51;
}

#dashboard-app aside h1 {
    color: #ef4444;

    font-size: 23px;

    font-weight: 800;

    letter-spacing: -1px;
}

#dashboard-app aside h1 span {
    color: #f1f5f9;
}

#dashboard-app aside h1 + p {
    margin-top: 6px;

    color: #64748b;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1.6px;

    text-transform: uppercase;
}


/* Navigation */

#dashboard-app nav {
    flex: 1;

    padding: 20px 15px;
}

.nav-link {
    height: 48px;

    display: flex;

    align-items: center;

    padding: 0 17px;

    margin-bottom: 8px;

    color: #94a3b8;

    border-radius: 9px;

    font-size: 14px;

    cursor: pointer;

    transition:
        background 0.2s,
        color 0.2s;
}

.nav-link:hover {
    color: white;

    background:
        rgba(255, 255, 255, 0.05);
}

.nav-link.active-tab {
    color: #f87171;

    background:
        rgba(239, 68, 68, 0.14);

    border-left:
        3px solid
        #ef4444;
}


/* Hide icon placeholders */

.nav-link [data-lucide] {
    display: none;
}


/* User section */

#dashboard-app aside > div:last-child {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 20px;

    border-top:
        1px solid
        #2c3b51;
}

#dashboard-app aside > div:last-child > div {
    display: flex;

    align-items: center;

    gap: 12px;
}

#user-avatar {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    color: white;

    background:
        #ef4444;

    border-radius: 50%;

    font-size: 13px;

    font-weight: 700;
}

#user-display-name {
    color: #e2e8f0;

    font-size: 14px;

    font-weight: 700;
}

#user-display-name + p {
    margin-top: 3px;

    color: #64748b;

    font-size: 11px;
}

#logout-btn {
    color: #94a3b8;

    background: transparent;

    border: none;

    font-size: 13px;
}


/* =========================================================
   4. MAIN CONTENT
========================================================= */

#dashboard-app main {
    margin-left: 255px;

    min-height: 100vh;

    padding: 32px 34px;

    background: #131c2c;
}


/* Tab */

.tab-content {
    width: 100%;
}


/* Page headings */

.tab-content h2 {
    color: #f1f5f9;

    font-size: 31px;

    font-weight: 700;

    margin-bottom: 7px;
}

.tab-content > p {
    color: #94a3b8;

    font-size: 15px;

    margin-bottom: 30px;
}


/* =========================================================
   5. DASHBOARD
========================================================= */

#tab-dashboard header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 32px;
}

#tab-dashboard header h2 {
    font-size: 31px;
}

#tab-dashboard header p {
    margin-top: 6px;

    color: #94a3b8;
}


/* System Secure */

#tab-dashboard header button {
    display: flex;

    align-items: center;

    padding:
        13px 20px;

    color: white;

    background:
        #dc2626;

    border: none;

    border-radius: 9px;

    font-size: 14px;

    font-weight: 700;
}


/* Statistics grid */

#tab-dashboard > .grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

    margin-bottom: 28px;
}

#tab-dashboard > .grid > .glass-card {
    padding: 25px;

    background:
        #1e293b;

    border:
        1px solid
        #334155;

    border-radius: 16px;
}

#tab-dashboard > .grid p {
    color: #94a3b8;

    font-size: 14px;
}

#tab-dashboard > .grid h3 {
    margin-top: 8px;

    color: white;

    font-size: 30px;
}

/* Dashboard statistic numbers */

.stat-number {
    margin-top: 4px;

    font-size: 30px;

    font-weight: 700;

    line-height: 1.2;
}


/* AI Voices Detected */

.stat-red {
    color: #ff4d4d !important;
}


/* Average Accuracy */

.stat-green {
    color: #4ade80 !important;
}

/* Quick analysis */

#tab-dashboard > .glass-card {
    padding: 45px;

    text-align: center;

    background:
        #182334;

    border:
        2px dashed
        #3b4a60;

    border-radius: 18px;
}

#tab-dashboard > .glass-card h4 {
    margin-bottom: 10px;

    color: white;

    font-size: 21px;
}

#tab-dashboard > .glass-card > p {
    margin-bottom: 25px;

    color: #94a3b8;
}

#tab-dashboard > .glass-card > div {
    display: flex;

    justify-content: center;

    gap: 15px;
}

.quick-nav-btn {
    padding:
        12px 25px;

    color: white;

    background:
        #334155;

    border: none;

    border-radius: 25px;

    font-size: 14px;
}

/* Real TIme Alert System */

